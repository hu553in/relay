{
  "name": "relay",
  "version": "0.1.0",
  "description": "Desktop app for live speech transcription and translated captions through the OpenAI Realtime API.",
  "private": true,
  "author": "hu553in",
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/ensure-electron.ts",
    "build": "bun postinstall && vite build && electron-builder",
    "dev": "bun postinstall && vite",
    "check": "lefthook run check --all-files --force",
    "check:fix": "lefthook run check-fix --all-files --force",
    "check:types": "bun tsc --pretty",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "prepare": "if [ \"$LEFTHOOK\" = \"0\" ]; then exit 0; fi; bun lefthook install || true",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@reactuses/core": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-icons": "^16.24.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-react/eslint-plugin": "^5.10.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-doctor": "^0.5.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "knip": "^6.23.0",
    "lefthook": "^2.1.9",
    "oxc-parser": "^0.138.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "release-it": "^20.2.1",
    "shadcn": "^4.12.0",
    "stylelint": "^17.14.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "yallist": "^5.0.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "lefthook"
  ],
  "main": "dist-electron/main.js"
}
